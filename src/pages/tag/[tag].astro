---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const uniqueTags = [...new Set(posts.map((post) => post.data.tags).flat())];
  
  return uniqueTags.map((tag) => {
    const filteredPosts = posts.filter((post) => post.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const titleSuffix = /节点|机场|推荐|评测|指南|教程/.test(tag) ? '相关文章合集' : '2026相关优质文章精选合集';
const dynamicTitle = `${tag}标签：${titleSuffix}`;
const dynamicDesc = `节点GO关于 ${tag} 标签的所有精选文章集合。获取最新最全的相关资源、深度测速指南及技巧分享。`;
---
<BaseLayout title={dynamicTitle} description={dynamicDesc}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <SectionTitle title={`# ${tag}`} description={`关于 ${tag} 的所有文章集合`} align="left" />
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
      {posts.map(post => (
        <ArticleCard 
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          category={post.data.category}
          href={`/blog/${post.id}`}
        />
      ))}
    </div>
  </div>
</BaseLayout>
