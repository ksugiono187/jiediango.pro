---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
console.log(`[DEBUG] post ID: ${post.id}, headings length: ${headings?.length}`);
if (headings?.length > 0) {
  console.log(`[DEBUG] first heading: ${headings[0].text}`);
}

const related = allPosts.filter(p => p.data.category === post.data.category && p.id !== post.id).slice(0, 3);
---
<BlogLayout 
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  category={post.data.category}
  author={post.data.author}
  headings={headings}
>
  <Content />
  {related.length > 0 && <RelatedPosts posts={related} />}
</BlogLayout>
