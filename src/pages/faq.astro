---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import FAQ from '../components/FAQ.astro';
import { fullFaqData } from '../data/faqData';
---
<BaseLayout title="机场常见问题解答_科学上网与节点连接排错指南" description="节点GO常见问题解答（FAQ）中心。为您系统整理关于机场选购技巧、节点连接失败排错、Clash/Sing-box客户端配置、流媒体解锁失效解决、晚高峰延迟波动处理以及防跑路避坑常识等核心疑问，提供通俗易懂的专业解决方案与操作指引。">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <SectionTitle title="常见问题解答 (FAQ)" description="关于机场选择、使用及网络安全的常见疑问解答。" />
    
    <div class="mt-12 bg-white p-4 md:p-8 rounded-2xl border border-slate-100 shadow-sm">
      <FAQ faqs={fullFaqData} />
    </div>
  </div>
</BaseLayout>
