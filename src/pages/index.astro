---
import LandingLayout from '../layouts/LandingLayout.astro';
import Hero from '../components/Hero.astro';
import StatsStrip from '../components/StatsStrip.astro';
import SectionTitle from '../components/SectionTitle.astro';
import UserPersona from '../components/UserPersona.astro';
import BrandCard from '../components/BrandCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import HowWeTest from '../components/HowWeTest.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TopicCluster from '../components/TopicCluster.astro';
import FAQ from '../components/FAQ.astro';
import Comments from '../components/Comments.astro';
import CTASection from '../components/CTASection.astro';
import NewsletterBox from '../components/NewsletterBox.astro';

import { homepageData } from '../data/homepage';
import { getCollection } from 'astro:content';
import { homeCompareData, homeCompareDimensions } from '../data/homeCompareData';

const posts = await getCollection('blog');
const recentPosts = posts.slice(0, 3);
const allBrands = await getCollection('brands');
const sortOrder = [
  'breezenet', 'feimao', 'muguang', 'wuyou', 'lingmao', 
  'shanyue', 'feiwei', 'kuajie', 'xingdaomeng', 'guangsu', 
  'weitu', 'u1s1', 'jilian', 'quanqiu', 'guangnian', 
  'sogo', 'yuzhou', 'ermao', 'yifan', 'bianyuan', 
  'kexin', 'sujie', 'kuaili', 'feiv', 'tizi', 
  'langwang', 'lingdong', 'yinxingren'
];
const brands = allBrands.sort((a, b) => {
  const indexA = sortOrder.indexOf(a.id);
  const indexB = sortOrder.indexOf(b.id);
  
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  return 0;
});
const topics = await getCollection('topics');

const brandList = brands.map(b => ({ id: b.id, name: b.data.name }));
const initialSelection = ['breezenet', 'feimao', 'muguang'];
---
<LandingLayout>
  <Hero {...homepageData.hero} />
  <StatsStrip stats={homepageData.stats} />

  <!-- 1. 你是哪一种用户 -->
  <UserPersona />

  <!-- 2. 编辑精选 -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionTitle title="🏆 2026 编辑精选" description="精挑细选，闭眼不坑。只展示综合实力最强的顶级服务商。" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {brands.slice(0, 6).map(brand => (
          <BrandCard 
            name={brand.data.name}
            description={brand.data.description}
            href={`/brands/${brand.id}`}
            tags={brand.data.tags}
            rating={brand.data.rating}
            price={brand.data.price}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 3. 横向对比 -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionTitle title="📊 28 款服务商横向对比" description="硬核数据，真实对比，帮您找到最适合的产品。" />
      <ComparisonTable 
        brands={brandList}
        dimensions={homeCompareDimensions}
        data={homeCompareData}
        initialSelection={initialSelection}
      />
      <div class="mt-8 text-center">
         <a href="/compare" class="inline-flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-xl text-white bg-slate-900 hover:bg-primary-600 shadow-lg hover:shadow-primary-600/30 transition-all duration-300">
           查看完整对比表
         </a>
      </div>
    </div>
  </section>

  <!-- 4. 我们如何测试 -->
  <HowWeTest />

  <!-- 5. 最新机场测评 -->
  <section class="py-20 bg-slate-50 border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionTitle title="最新机场测评" description="独立深度的评测文章，追踪服务商最新状态。" />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {recentPosts.map(post => (
          <ArticleCard 
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category || '评测'}
            href={`/blog/${post.slug}`}
          />
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/blog" class="inline-flex items-center text-primary-600 font-bold hover:text-primary-700 transition-colors">
          查看所有文章 <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. 网络教程 -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionTitle title="网络教程" description="从入门到进阶，解决各类网络疑难杂症。" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {topics.map(topic => (
          <TopicCluster 
            title={topic.data.name}
            description={topic.data.description}
            count={topic.data.count || 5}
            href={`/topics/${topic.id}`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section id="faq" class="py-20 bg-slate-50 border-y border-slate-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionTitle title="常见问题解答 (FAQ)" />
      <FAQ faqs={homepageData.faqs} />
    </div>
  </section>

  <!-- 8. 评论交流 -->
  <section class="pb-20 pt-10 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Comments />
    </div>
  </section>
  
  <CTASection {...homepageData.cta} />
</LandingLayout>
