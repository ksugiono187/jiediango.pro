---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import BrandCard from '../../components/BrandCard.astro';
import { getCollection } from 'astro:content';

const allBrands = await getCollection('brands');

const sortOrder = [
  'breezenet', 'feimao', 'muguang', 'wuyou', 'lingmao', 
  'shanyue', 'feiwei', 'kuajie', 'xingdaomeng', 'guangsu', 
  'weitu', 'u1s1', 'jilian', 'quanqiu', 'guangnian', 
  'sogo', 'yuzhou', 'ermao', 'yifan', 'bianyuan', 
  'kexin', 'sujie', 'kuaili', 'feiv', 'tizi', 
  'langwang', 'lingdong', 'yinxingren'
];

const brands = allBrands.sort((a, b) => {
  const indexA = sortOrder.indexOf(a.id);
  const indexB = sortOrder.indexOf(b.id);
  
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  
  return a.data.name.localeCompare(b.data.name, 'zh-CN');
});
---
<BaseLayout title="机场推荐品牌库_优质梯子节点服务商汇总" description="汇总2026年优质科学上网机场品牌，涵盖大厂机场、IEPL专线机场、平价性价比梯子，提供详细的节点分布、价格套餐及测速评测报告。">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <SectionTitle title="机场推荐 优选品牌库" description="经过深度体验与长期测试，为您推荐最靠谱的服务商。" align="left" />
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mt-12">
      {brands.map(brand => (
        <BrandCard 
          name={brand.data.name}
          description={brand.data.description}
          href={`/brands/${brand.id}`}
          tags={brand.data.tags}
        />
      ))}
    </div>
  </div>
</BaseLayout>
