---
interface Props {
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { title, description, align = 'center' } = Astro.props;
---
<div class={`mb-12 ${align === 'center' ? 'text-center' : 'text-left'}`}>
  <h2 class="text-3xl font-bold text-slate-900">{title}</h2>
  {description && <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">{description}</p>}
</div>
