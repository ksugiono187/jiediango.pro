---
interface Props {
  title: string;
  subtitle: string;
  primaryCta: { text: string; href: string };
  secondaryCta: { text: string; href: string };
}
const { title, subtitle, primaryCta, secondaryCta } = Astro.props;
---
<section class="relative bg-gradient-to-b from-primary-50 to-white overflow-hidden py-20 lg:py-32 border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 mb-6">
      {title}
    </h1>
    <p class="mt-4 text-xl text-slate-600 max-w-3xl mx-auto mb-10">
      {subtitle}
    </p>
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
      <a href={primaryCta.href} class="btn-primary w-full sm:w-auto text-lg px-8 py-3">{primaryCta.text}</a>
      <a href={secondaryCta.href} class="btn-secondary w-full sm:w-auto text-lg px-8 py-3">{secondaryCta.text}</a>
    </div>
  </div>
</section>
