---
interface Props {
  name: string;
  description: string;
  href: string;
  tags?: string[];
}
const { name, description, href, tags = [] } = Astro.props;
---
<a href={href} class="card p-6 block hover:border-primary-300">
  <h3 class="text-lg font-bold text-slate-900 mb-2">{name}</h3>
  <p class="text-slate-600 text-sm mb-4 line-clamp-2">{description}</p>
  {tags.length > 0 && (
    <div class="mt-4 pt-3 border-t border-slate-100">
      <div class="text-[10px] text-slate-400 font-medium mb-2 uppercase tracking-wider flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        官方宣称亮点
      </div>
      <div class="flex flex-wrap gap-2">
        {tags.map(tag => (
          <span class="text-xs bg-slate-50 text-slate-600 px-2 py-1 rounded-md border border-slate-100">{tag}</span>
        ))}
      </div>
    </div>
  )}
</a>
