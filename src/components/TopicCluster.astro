---
interface Props {
  title: string;
  description: string;
  count: number;
  href: string;
}
const { title, description, count, href } = Astro.props;
---
<a href={href} class="card p-6 flex items-start justify-between group hover:border-primary-300">
  <div>
    <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-primary-600 transition-colors">{title}</h3>
    <p class="text-slate-600 text-sm max-w-sm">{description}</p>
  </div>
  <div class="bg-primary-50 text-primary-700 text-xs font-semibold px-3 py-1 rounded-full">
    {count} 篇文章
  </div>
</a>
