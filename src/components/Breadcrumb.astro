---
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
---
<nav class="flex text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
  <ol class="inline-flex items-center space-x-1 md:space-x-3">
    {items.map((item, index) => (
      <li class="inline-flex items-center">
        {index > 0 && <span class="mx-2 text-slate-400">/</span>}
        {index === items.length - 1 ? (
          <span class="text-slate-900 font-medium">{item.name}</span>
        ) : (
          <a href={item.href} class="hover:text-primary-600 transition-colors">
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
