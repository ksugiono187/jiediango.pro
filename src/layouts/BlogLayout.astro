---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  author?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, pubDate, updatedDate, category, author, headings = [] } = Astro.props;

const breadcrumbs = [
  { name: '首页', href: '/' },
  { name: '机场测评', href: '/blog/' },
  { name: title, href: '#' }
];
---

<BaseLayout title={title} description={description} ogType="article">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
      
      <!-- Article Content -->
      <article class="lg:col-span-3 w-full px-6 sm:px-10 lg:px-12 py-12 bg-white/60 backdrop-blur-xl border border-white/60 shadow-xl shadow-primary-900/5 rounded-3xl transition-all duration-300 hover:shadow-2xl hover:shadow-primary-900/10 hover:bg-white/70">
        <Breadcrumb items={breadcrumbs} />
        
        <header class="mt-8 mb-12">
          <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">{title}</h1>
          <div class="flex flex-wrap items-center text-sm text-slate-500 gap-4">
            {author && <span>作者：{author}</span>}
            <span>分类：<a href={`/category/${category}`} class="text-primary-600 hover:underline">{category}</a></span>
            <time datetime={pubDate.toISOString()}>
              发布于：{pubDate.toLocaleDateString('zh-CN')}
            </time>
          </div>
        </header>

        {headings && headings.length > 0 && (
          <details class="lg:hidden mb-8 bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden [&_summary::-webkit-details-marker]:hidden group">
            <summary class="flex justify-between items-center p-5 cursor-pointer font-bold text-slate-900 bg-white/50">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                文章目录
              </div>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="p-5 border-t border-slate-100 bg-white/30 space-y-3 max-h-80 overflow-y-auto">
              {headings.filter(h => h.depth <= 3).map((heading) => (
                <a 
                  href={`#${heading.slug}`} 
                  class={`block text-sm transition-colors hover:text-primary-600 leading-relaxed text-slate-800 font-medium border-b border-slate-100/50 pb-2 last:border-0 ${heading.depth === 3 ? 'pl-4 text-slate-600 text-xs' : ''}`}
                >
                  {heading.text}
                </a>
              ))}
            </div>
          </details>
        )}

        <div class="prose-custom max-w-none">
          <slot />
        </div>
      </article>

      <!-- TOC Sidebar -->
      <aside class="hidden lg:block lg:col-span-1 sticky top-24">
        <div class="bg-white/80 backdrop-blur-xl border border-white shadow-xl shadow-primary-900/5 rounded-3xl p-6">
          <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
            文章目录
          </h3>
          <nav class="space-y-3 max-h-[calc(100vh-12rem)] overflow-y-auto custom-scrollbar pr-2">
            {headings && headings.filter(h => h.depth <= 3).map((heading) => (
              <a 
                href={`#${heading.slug}`} 
                class={`block text-sm transition-colors hover:text-primary-600 leading-relaxed text-slate-800 font-medium border-b border-slate-100 pb-2 last:border-0 ${heading.depth === 3 ? 'pl-4 text-slate-600 text-xs' : ''}`}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </div>
</BaseLayout>
